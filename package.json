{
  "name": "anomia-launcher",
  "productName": "Kannibal Launcher",
  "version": "1.9.10",
  "description": "Kannibal Launcher - le launcher des serveurs Kannibal Team (Anomia RP, KannibAventure)",
  "main": "main.js",
  "author": "B2OBI64",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:win:publish": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1",
    "adm-zip": "^0.5.16",
    "msmc": "^5.0.5"
  },
  "build": {
    "appId": "tv.twitch.b2obi64.anomia.launcher",
    "productName": "Kannibal Launcher",
    "files": [
      "main.js",
      "kb-launch.js",
      "kb-install.js",
      "config.js",
      "preload.js",
      "diagnostics.js",
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "B2OBI64",
      "repo": "anomia-launcher",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kannibal Launcher"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum"
  }
}
